diff --git a/fs/stat.c b/fs/stat.c
--- a/fs/stat.c
+++ b/fs/stat.c
@@ -87,5 +87,16 @@ int vfs_getattr_nosec(const struct path *path, struct kstat *stat,
 	memset(stat, 0, sizeof(*stat));
 	stat->result_mask |= STATX_BASIC_STATS;
 	query_flags &= KSTAT_QUERY_FLAGS;
+#ifdef CONFIG_KSU_SUSFS_SUS_KSTAT
+	if (susfs_is_current_app_uid()) {
+		bool is_fuse = false;
+		if (susfs_is_inode_sus_kstat(inode, &is_fuse)) {
+			if (!is_fuse)
+				stat->result_mask |= STATX_SUS_KSTAT;
+			else
+				stat->result_mask |= STATX_SUS_KSTAT_FUSE;
+		}
+	}
+#endif
 
 	/* allow the fs to override these if it really wants to */
@@ -97,9 +108,38 @@ int vfs_getattr_nosec(const struct path *path, struct kstat *stat,
 	if (IS_DAX(inode))
 		stat->attributes |= STATX_ATTR_DAX;
 
-	if (inode->i_op->getattr)
+	if (inode->i_op->getattr) {
+#ifdef CONFIG_KSU_SUSFS_SUS_KSTAT
+		int err = inode->i_op->getattr(path, stat, request_mask,
+					       query_flags);
+		if (!err && (stat->result_mask & STATX_SUS_KSTAT)) {
+			susfs_sus_kstat_spoof_generic_fillattr(inode, stat,
+							      STATX_SUS_KSTAT);
+		} else if (!err && (stat->result_mask & STATX_SUS_KSTAT_FUSE)) {
+			susfs_sus_kstat_spoof_generic_fillattr(inode, stat,
+							      STATX_SUS_KSTAT_FUSE);
+		}
+		return err;
+#else
 		return inode->i_op->getattr(path, stat, request_mask,
 					    query_flags);
+#endif
+	}
+
+#ifdef CONFIG_KSU_SUSFS_SUS_KSTAT
+	if (stat->result_mask & STATX_SUS_KSTAT) {
+		generic_fillattr(inode, stat);
+		susfs_sus_kstat_spoof_generic_fillattr(inode, stat,
+						      STATX_SUS_KSTAT);
+		return 0;
+	}
+	if (stat->result_mask & STATX_SUS_KSTAT_FUSE) {
+		generic_fillattr(inode, stat);
+		susfs_sus_kstat_spoof_generic_fillattr(inode, stat,
+						      STATX_SUS_KSTAT_FUSE);
+		return 0;
+	}
+#endif
 
 	generic_fillattr(inode, stat);
